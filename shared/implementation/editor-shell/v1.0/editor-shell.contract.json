{
  "schemaVersion": 1,
  "shellVersion": "1.0",
  "metadata": {
    "versionMetaName": "sss-editor-shell",
    "contractHashMetaName": "sss-editor-shell-contract-sha256"
  },
  "outputPolicy": {
    "canonicalFormat": "HTML",
    "effectiveFrom": "SSS-C1-CASE03",
    "requiredArtifacts": [
      "portable-editable-master",
      "student",
      "teacher",
      "answer",
      "accessible",
      "grayscale"
    ],
    "workflowGeneratesPdf": false,
    "browserPrintAvailable": true,
    "browserPdfAccessibilityGuaranteed": false,
    "manualPdfDistributionRequiresAccessibilityVerification": true
  },
  "toolbar": {
    "literalReference": "sss/campaign-1/case-02-lunar-greenhouse/master/SSS_C1_CASE02_EDITABLE_MASTER_v1.0.html",
    "controlOrder": [
      "roleControl",
      "fillControl",
      "editControl",
      "marginTop",
      "marginRight",
      "marginBottom",
      "marginLeft",
      "marginReset",
      "densityControl",
      "grayControl",
      "guideControl",
      "boundaryControl",
      "printButton",
      "downloadButton",
      "clearButton",
      "resetButton",
      "stateStatus",
      "overflowStatus"
    ],
    "labels": {
      "roleControl": "Role",
      "fillControl": "Fill responses",
      "editControl": "Edit text",
      "marginTop": "Top",
      "marginRight": "Right",
      "marginBottom": "Bottom",
      "marginLeft": "Left",
      "marginReset": "Reset margins",
      "densityControl": "Density",
      "grayControl": "Grayscale",
      "guideControl": "Guides",
      "boundaryControl": "Boundaries",
      "printButton": "Print / Save PDF",
      "downloadButton": "Download Current HTML",
      "clearButton": "Clear Current Role",
      "resetButton": "Reset Source"
    }
  },
  "pageIdentity": {
    "firstSelector": "[data-page-identity=\"first\"]",
    "continuationSelector": "[data-page-identity=\"continuation\"]",
    "footerSelector": "[data-publication-footer]",
    "firstPagePerRole": true,
    "oneIdentityAndFooterPerPage": true
  },
  "commonComponents": {
    "source": "curriculum-components.css",
    "selectors": [
      ".page",
      ".page-frame",
      ".student-id",
      ".mission-title-block",
      ".continuation-header",
      ".saa-insignia",
      ".institution",
      ".response",
      ".callout",
      ".data-table",
      ".figure"
    ]
  },
  "taskHeading": {
    "semanticLabelPt": 7,
    "semanticLabelWeight": 700,
    "semanticLabelTrackingPx": 0.8,
    "taskTitlePt": 11.5,
    "taskTitleWeight": 800,
    "taskTitleLineHeight": 1.15,
    "accessibleTaskTitlePt": 14,
    "iconPx": 20,
    "forbiddenSemanticLabelPattern": "^TASK\\s+0?[0-9]+$",
    "allowedSemanticLabels": [
      "REFERENCE",
      "PREDICTION",
      "EVIDENCE TASK",
      "DATA ANALYSIS",
      "CAUSE TEST",
      "PATTERN ANALYSIS",
      "DIAGNOSIS",
      "MECHANISM MODEL",
      "EXPLANATION",
      "ENGINEERING RESPONSE",
      "TRANSFER CHECK",
      "EXIT TICKET",
      "OPTIONAL EXTENSION"
    ]
  },
  "cer": {
    "version": "1.0",
    "contracts": ["student-v1.0", "answer-v1.0", "accessible-v1.0"],
    "stackMinHeightIn": 2.55,
    "labelColumnIn": 0.72,
    "gapIn": 0.055,
    "claimBasisIn": 0.46,
    "evidenceBasisIn": 0.66,
    "reasoningBasisIn": 0.76
  },
  "processModel": {
    "contract": "five-stage-v1.0",
    "stageCount": 5,
    "connectorCount": 4,
    "standardLayout": "horizontal",
    "accessibleLayout": "vertical"
  },
  "optionalExtension": {
    "contract": "canonical-v1.0",
    "placement": "after-required-tasks-only-when-surplus-space-remains"
  },
  "requiredRuntimeApi": [
    "loadState",
    "saveState",
    "serializePortableHTML",
    "downloadPortableHTML",
    "clearCurrentRole",
    "resetSource",
    "setRole",
    "checkOverflow"
  ]
}
