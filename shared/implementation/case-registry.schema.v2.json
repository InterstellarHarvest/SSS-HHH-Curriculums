{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interstellarharvest.example/schemas/case-registry.v2.json",
  "title": "Canonical curriculum case registry",
  "type": "object",
  "required": ["schemaVersion", "productionPolicy", "curricula"],
  "properties": {
    "schemaVersion": {"const": 2},
    "productionPolicy": {
      "type": "object",
      "required": ["canonicalSource", "generatedArtifacts", "pdfStorage", "caseFolderStandard"],
      "properties": {
        "canonicalSource": {"const": "CASE_PACKAGE"},
        "generatedArtifacts": {"const": "ON_DEMAND_TEMPORARY"},
        "pdfStorage": {"const": "PROHIBITED"},
        "caseFolderStandard": {"const": "CANONICAL_V1"}
      },
      "additionalProperties": false
    },
    "curricula": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "campaigns"],
        "properties": {
          "id": {"enum": ["SSS", "HHH"]},
          "title": {"type": "string", "minLength": 1},
          "campaigns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "cases"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "title": {"type": "string", "minLength": 1},
                "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["id", "displayOrder", "displayLabel", "title", "version", "status", "editorShell", "centralWorkflow", "packageStatus", "approval"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "displayOrder": {"type": "integer", "minimum": 1},
        "displayLabel": {"type": "string", "pattern": "^(?:[0-9]+ - .+|Archive Orientation|Campaign 1 Synthesis|Program Capstone)$"},
        "title": {"type": "string", "minLength": 1},
        "instructionalType": {"enum": ["ORIENTATION", "CORE_CASE", "SYNTHESIS", "CAPSTONE"]},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "status": {"enum": ["DRAFT", "VALIDATION_BUILD", "OWNER_GATE_OPEN", "APPROVED_STABLE"]},
        "editorShell": {"const": "1.0"},
        "editorPackage": {"type": "string", "pattern": "/source/case-package\\.json$"},
        "centralWorkflow": {"const": "CANONICAL"},
        "packageStatus": {"enum": ["DRAFT", "VALIDATION", "OWNER_REVIEW", "APPROVED"]},
        "approval": {
          "type": "object",
          "required": ["owner", "status", "printStatus"],
          "properties": {
            "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "owner": {"type": "string", "minLength": 1},
            "status": {"enum": ["OWNER_REVIEW_NOT_STARTED", "OWNER_REVIEW_IN_PROGRESS", "OWNER_REVIEW_PASS", "APPROVED"]},
            "printStatus": {"enum": ["NOT_RUN", "PASS", "FAIL"]}
          },
          "additionalProperties": false
        },
        "historyRecord": {"type": "string", "pattern": "/history/release-v[0-9]+\\.[0-9]+\\.json$"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "APPROVED_STABLE"}}},
          "then": {
            "required": ["historyRecord"],
            "properties": {
              "packageStatus": {"const": "APPROVED"},
              "approval": {
                "required": ["date", "owner", "status", "printStatus"],
                "properties": {"status": {"const": "APPROVED"}, "printStatus": {"const": "PASS"}}
              }
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "DRAFT"}}},
          "then": {
            "not": {"required": ["historyRecord"]},
            "properties": {
              "packageStatus": {"const": "DRAFT"},
              "approval": {"properties": {"status": {"const": "OWNER_REVIEW_NOT_STARTED"}}}
            }
          }
        },
        {
          "if": {"properties": {"status": {"enum": ["DRAFT", "VALIDATION_BUILD", "OWNER_GATE_OPEN"]}}},
          "then": {"not": {"required": ["historyRecord"]}}
        },
        {
          "if": {"not": {"required": ["editorPackage"]}},
          "then": {
            "properties": {"status": {"const": "DRAFT"}},
            "not": {"required": ["historyRecord"]}
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
