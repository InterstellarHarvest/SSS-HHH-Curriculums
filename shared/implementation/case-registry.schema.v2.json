{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interstellarharvest.example/schemas/case-registry.v2.json",
  "title": "Canonical curriculum case registry",
  "type": "object",
  "required": ["schemaVersion", "productionPolicy", "curricula"],
  "properties": {
    "schemaVersion": {"const": 2},
    "productionPolicy": {
      "type": "object",
      "required": ["canonicalSource", "generatedArtifacts", "pdfStorage", "caseFolderStandard"],
      "properties": {
        "canonicalSource": {"const": "CASE_PACKAGE"},
        "generatedArtifacts": {"const": "ON_DEMAND_TEMPORARY"},
        "pdfStorage": {"const": "PROHIBITED"},
        "caseFolderStandard": {"const": "CANONICAL_V1"}
      },
      "additionalProperties": false
    },
    "curricula": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "campaigns"],
        "properties": {
          "id": {"enum": ["SSS", "HHH"]},
          "title": {"type": "string", "minLength": 1},
          "campaigns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "cases"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "title": {"type": "string", "minLength": 1},
                "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["id", "displayOrder", "displayLabel", "title", "version", "status", "editorShell", "editorPackage", "centralWorkflow", "packageStatus", "approval", "historyRecord"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "displayOrder": {"type": "integer", "minimum": 1},
        "displayLabel": {"type": "string", "pattern": "^[0-9]+ - .+"},
        "title": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "status": {"const": "APPROVED_STABLE"},
        "editorShell": {"const": "1.0"},
        "editorPackage": {"type": "string", "pattern": "/source/case-package\\.json$"},
        "centralWorkflow": {"const": "CANONICAL"},
        "packageStatus": {"const": "APPROVED"},
        "approval": {
          "type": "object",
          "required": ["date", "owner", "status", "printStatus"],
          "properties": {
            "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "owner": {"type": "string", "minLength": 1},
            "status": {"const": "APPROVED"},
            "printStatus": {"const": "PASS"}
          },
          "additionalProperties": false
        },
        "historyRecord": {"type": "string", "pattern": "/history/release-v[0-9]+\\.[0-9]+\\.json$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
