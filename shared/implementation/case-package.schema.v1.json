{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interstellarharvest.example/schemas/case-package.v1.json",
  "title": "SSS/HHH curriculum editor case package",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "curriculum",
    "campaign",
    "title",
    "subtitle",
    "location",
    "version",
    "status",
    "institutionalIdentity",
    "documentKey",
    "supportedRoles",
    "defaultRole",
    "shell",
    "taskRegistry",
    "content",
    "styles",
    "assets",
    "rolePageStructure",
    "outputs",
    "defaultToolbarState",
    "accessibility"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Z]{3}-C[0-9]+-CASE[0-9]{2}$" },
    "curriculum": { "enum": ["SSS", "HHH"] },
    "campaign": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string", "minLength": 1 },
    "location": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "status": { "type": "string", "minLength": 1 },
    "institutionalIdentity": {
      "type": "object",
      "required": ["id", "name", "lockupLines", "insigniaSelector"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "lockupLines": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "insigniaSelector": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "documentKey": { "type": "string", "minLength": 12 },
    "supportedRoles": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": { "enum": ["student", "teacher", "answer", "accessible", "grayscale"] }
    },
    "defaultRole": { "enum": ["student", "teacher", "answer", "accessible", "grayscale"] },
    "shell": {
      "type": "object",
      "required": ["version", "toolbar", "styles", "icons"],
      "properties": {
        "version": { "const": "1.0" },
        "toolbar": { "type": "string", "minLength": 1 },
        "styles": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "icons": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "taskRegistry": {
      "type": "object",
      "required": ["source", "global", "schemaVersion"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "global": { "type": "string", "minLength": 1 },
        "schemaVersion": { "const": 1 }
      },
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "required": ["source", "format"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "format": { "const": "html-fragment" }
      },
      "additionalProperties": false
    },
    "styles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "scope"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "scope": { "enum": ["shared", "case"] }
        },
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "embed"],
        "anyOf": [
          { "required": ["source"] },
          { "required": ["selector"] }
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "embed": { "const": true },
          "source": { "type": "string", "minLength": 1 },
          "selector": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "rolePageStructure": {
      "type": "object",
      "required": ["student", "teacher", "answer", "accessible", "grayscale"],
      "properties": {
        "student": {
          "type": "object",
          "required": ["sourceRole", "documentRole", "pageCount", "grayscale"],
          "properties": {
            "sourceRole": { "const": "student" },
            "documentRole": { "type": "string", "minLength": 1 },
            "pageCount": { "type": "integer", "minimum": 1 },
            "grayscale": { "const": false }
          },
          "additionalProperties": false
        },
        "teacher": {
          "type": "object",
          "required": ["sourceRole", "documentRole", "pageCount", "grayscale"],
          "properties": {
            "sourceRole": { "const": "teacher" },
            "documentRole": { "type": "string", "minLength": 1 },
            "pageCount": { "type": "integer", "minimum": 1 },
            "grayscale": { "const": false }
          },
          "additionalProperties": false
        },
        "answer": {
          "type": "object",
          "required": ["sourceRole", "documentRole", "pageCount", "grayscale"],
          "properties": {
            "sourceRole": { "const": "answer" },
            "documentRole": { "type": "string", "minLength": 1 },
            "pageCount": { "type": "integer", "minimum": 1 },
            "grayscale": { "const": false }
          },
          "additionalProperties": false
        },
        "accessible": {
          "type": "object",
          "required": ["sourceRole", "documentRole", "pageCount", "grayscale"],
          "properties": {
            "sourceRole": { "const": "accessible" },
            "documentRole": { "type": "string", "minLength": 1 },
            "pageCount": { "type": "integer", "minimum": 1 },
            "grayscale": { "const": false }
          },
          "additionalProperties": false
        },
        "grayscale": {
          "type": "object",
          "required": ["sourceRole", "documentRole", "pageCount", "grayscale"],
          "properties": {
            "sourceRole": { "const": "student" },
            "documentRole": { "type": "string", "minLength": 1 },
            "pageCount": { "type": "integer", "minimum": 1 },
            "grayscale": { "const": true }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "outputs": {
      "type": "object",
      "required": ["complete", "student", "teacher", "answer", "accessible", "grayscale"],
      "properties": {
        "complete": { "type": "string", "minLength": 1 },
        "student": { "type": "string", "minLength": 1 },
        "teacher": { "type": "string", "minLength": 1 },
        "answer": { "type": "string", "minLength": 1 },
        "accessible": { "type": "string", "minLength": 1 },
        "grayscale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "defaultToolbarState": {
      "type": "object",
      "required": [
        "role",
        "fillMode",
        "editMode",
        "marginTop",
        "marginRight",
        "marginBottom",
        "marginLeft",
        "density",
        "grayscale",
        "guides",
        "boundaries"
      ],
      "properties": {
        "role": { "enum": ["student", "teacher", "answer", "accessible", "grayscale"] },
        "fillMode": { "type": "boolean" },
        "editMode": { "type": "boolean" },
        "marginTop": { "type": "number", "minimum": 0.25, "maximum": 1 },
        "marginRight": { "type": "number", "minimum": 0.25, "maximum": 1 },
        "marginBottom": { "type": "number", "minimum": 0.25, "maximum": 1 },
        "marginLeft": { "type": "number", "minimum": 0.25, "maximum": 1 },
        "density": { "enum": ["normal", "compact", "spacious"] },
        "grayscale": { "type": "boolean" },
        "guides": { "type": "boolean" },
        "boundaries": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "accessibility": {
      "type": "object",
      "required": ["language", "documentTitle", "loadAnnouncement", "extendedDescriptionSelectors", "pdfNotice"],
      "properties": {
        "language": { "const": "en" },
        "documentTitle": { "type": "string", "minLength": 1 },
        "loadAnnouncement": { "type": "string", "minLength": 1 },
        "extendedDescriptionSelectors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "pdfNotice": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "migrationSource": {
      "type": "object",
      "required": ["kind", "historicalMaster", "historicalMasterSha256", "successorMaster", "successorMasterSha256", "reason", "builder"],
      "properties": {
        "kind": { "const": "approved-master-successor" },
        "historicalMaster": { "type": "string", "minLength": 1 },
        "historicalMasterSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "successorMaster": { "type": "string", "minLength": 1 },
        "successorMasterSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reason": { "type": "string", "minLength": 1 },
        "builder": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "presentation": {
      "type": "object",
      "required": ["contentSha256", "caseCssSha256", "stylesheet", "stylesheetSha256", "isolation"],
      "properties": {
        "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "caseCssSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "stylesheet": { "type": "string", "minLength": 1 },
        "stylesheetSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "isolation": { "enum": ["shadow-dom"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
