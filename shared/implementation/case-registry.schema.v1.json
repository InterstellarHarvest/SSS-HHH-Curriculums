{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interstellarharvest.example/schemas/case-registry.v1.json",
  "title": "SSS/HHH repository case registry",
  "type": "object",
  "required": ["schemaVersion", "productionPolicy", "curricula"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "productionPolicy": {
      "type": "object",
      "required": ["newProduction", "effectiveFrom", "pdfPathsAllowed"],
      "properties": {
        "newProduction": { "const": "HTML_ONLY" },
        "effectiveFrom": { "const": "SSS-C1-CASE03" },
        "pdfPathsAllowed": { "const": false }
      },
      "additionalProperties": false
    },
    "curricula": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "campaigns"],
        "properties": {
          "id": { "enum": ["SSS", "HHH"] },
          "title": { "type": "string", "minLength": 1 },
          "campaigns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "cases"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 1 },
                "cases": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "title", "version", "status", "artifactPolicy", "master", "roles"],
                    "properties": {
                      "id": { "type": "string", "minLength": 1 },
                      "title": { "type": "string", "minLength": 1 },
                      "version": { "type": "string", "minLength": 1 },
                      "status": { "type": "string", "minLength": 1 },
                      "artifactPolicy": {
                        "enum": ["HISTORICAL_PDFS_RETAINED", "HTML_ONLY"]
                      },
                      "editorShell": { "type": ["string", "null"] },
                      "editorPackage": { "type": "string", "minLength": 1 },
                      "master": { "type": "string", "minLength": 1 },
                      "approval": {
                        "type": "object",
                        "required": ["date", "tester", "ownerReview", "browserPhysicalPrint", "scale", "printer", "paper", "artifactPolicy"],
                        "properties": {
                          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                          "tester": { "type": "string", "minLength": 1 },
                          "ownerReview": { "const": "PASS" },
                          "browserPhysicalPrint": { "const": "PASS" },
                          "scale": { "const": "100% / Actual Size" },
                          "printer": { "const": "Not recorded" },
                          "paper": { "const": "Not recorded" },
                          "artifactPolicy": { "const": "HTML_ONLY" }
                        },
                        "additionalProperties": false
                      },
                      "roles": {
                        "type": "object",
                        "additionalProperties": { "type": "string", "minLength": 1 }
                      },
                      "historicalReleases": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["version", "status", "master", "masterSha256", "roles"],
                          "properties": {
                            "version": { "type": "string", "minLength": 1 },
                            "status": { "type": "string", "minLength": 1 },
                            "master": { "type": "string", "minLength": 1 },
                            "masterSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                            "roles": {
                              "type": "object",
                              "additionalProperties": { "type": "string", "minLength": 1 }
                            }
                          },
                          "additionalProperties": false
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
