{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interstellarharvest.example/schemas/case-registry.v1.json",
  "title": "SSS/HHH repository case registry",
  "type": "object",
  "required": ["schemaVersion", "productionPolicy", "curricula"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "productionPolicy": {
      "type": "object",
      "required": ["newProduction", "effectiveFrom", "pdfPathsAllowed"],
      "properties": {
        "newProduction": { "const": "HTML_ONLY" },
        "effectiveFrom": { "const": "SSS-C1-CASE03" },
        "pdfPathsAllowed": { "const": false }
      },
      "additionalProperties": false
    },
    "curricula": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "campaigns"],
        "properties": {
          "id": { "enum": ["SSS", "HHH"] },
          "title": { "type": "string", "minLength": 1 },
          "campaigns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title", "cases"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 1 },
                "cases": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "displayOrder", "displayLabel", "title", "version", "status", "artifactPolicy", "editorShell", "editorPackage", "centralWorkflow", "packageStatus", "legacyEmbeddedEditorStatus", "approvedMasterStatus", "cutoverManifest", "master", "currentMasterSha256", "roles", "currentRoleSha256"],
                    "properties": {
                      "id": { "type": "string", "minLength": 1 },
                      "displayOrder": { "type": "integer", "minimum": 1 },
                      "displayLabel": { "type": "string", "pattern": "^[0-9]+ - .+" },
                      "title": { "type": "string", "minLength": 1 },
                      "version": { "type": "string", "minLength": 1 },
                      "status": { "type": "string", "minLength": 1 },
                      "artifactPolicy": {
                        "enum": ["HISTORICAL_PDFS_RETAINED", "HTML_ONLY"]
                      },
                      "editorShell": { "type": ["string", "null"] },
                      "editorPackage": { "type": "string", "minLength": 1 },
                      "centralWorkflow": { "const": "CANONICAL" },
                      "packageStatus": { "const": "APPROVED" },
                      "legacyEmbeddedEditorStatus": { "const": "DEPRECATED_COMPATIBILITY" },
                      "approvedMasterStatus": { "const": "APPROVED_RELEASE_SNAPSHOT" },
                      "cutoverManifest": { "const": "shared/implementation/CURRICULUM_EDITOR_CUTOVER_v1.json" },
                      "master": { "type": "string", "minLength": 1 },
                      "htmlMaintenanceRevision": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                      "reconciliationRecord": { "type": "string", "minLength": 1 },
                      "currentMasterSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                      "ownerAuthorization": { "enum": ["OWNER_AUTHORIZED_FOR_PHASE2", "APPROVED"] },
                      "currentMaintainedHtml": { "const": "APPROVED" },
                      "phase2Status": { "const": "READY_TO_MERGE" },
                      "physicalPrintGate": { "enum": ["OPEN", "PASS"] },
                      "approval": {
                        "type": "object",
                        "required": ["date", "tester", "ownerReview", "browserPhysicalPrint", "scale", "printer", "paper", "artifactPolicy"],
                        "properties": {
                          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                          "tester": { "type": "string", "minLength": 1 },
                          "ownerReview": { "const": "PASS" },
                          "browserPhysicalPrint": { "const": "PASS" },
                          "scale": { "const": "100% / Actual Size" },
                          "printer": { "const": "Not recorded" },
                          "paper": { "const": "Not recorded" },
                          "artifactPolicy": { "enum": ["HTML_ONLY", "HISTORICAL_PDFS_RETAINED"] },
                          "browser": { "const": "Not recorded" },
                          "browserPrintPreview": { "const": "PASS" },
                          "physicalPrintReview": { "const": "PASS" },
                          "phase2MigrationParity": { "const": "PASS" },
                          "currentMaintainedHtml": { "const": "APPROVED" },
                          "currentProduction": { "enum": ["HTML_BASED", "HTML_ONLY"] },
                          "newPdfsGenerated": { "const": false },
                          "approvalRecord": { "type": "string", "minLength": 1 }
                        },
                        "additionalProperties": false
                      },
                      "roles": {
                        "type": "object",
                        "additionalProperties": { "type": "string", "minLength": 1 }
                      },
                      "currentRoleSha256": {
                        "type": "object",
                        "required": ["student", "teacher", "answer", "accessible", "grayscale"],
                        "properties": {
                          "student": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                          "teacher": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                          "answer": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                          "accessible": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                          "grayscale": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                        },
                        "additionalProperties": false
                      },
                      "historicalReleases": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["version", "status", "master", "masterSha256", "roles"],
                          "properties": {
                            "version": { "type": "string", "minLength": 1 },
                            "status": { "type": "string", "minLength": 1 },
                            "master": { "type": "string", "minLength": 1 },
                            "masterSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                            "roles": {
                              "type": "object",
                              "additionalProperties": { "type": "string", "minLength": 1 }
                            }
                          },
                          "additionalProperties": false
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
